<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php" cacheDirectory=".phpunit.cache"
         failOnEmptyTestSuite="true" failOnRisky="true" failOnWarning="true" failOnDeprecation="true">
    <testsuites>
        <testsuite name="Real MySQL connection">
            <directory suffix="Test.php">tests/Database</directory>
        </testsuite>
    </testsuites>
</phpunit>
