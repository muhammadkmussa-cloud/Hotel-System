# Local example only. Each deployment supplies its own HTTPS origin and key.
APP_NAME="Hotel System"
APP_ENV=local
APP_URL=http://127.0.0.1:8000
APP_KEY=
# Detailed public errors are disabled in application configuration.
# Private database credentials belong to this installation only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Provider CA file for a remote TLS connection, when required by the host.
DB_SSL_CA=

# Private installer secret authorizing owner bootstrap and the first-install setup screen.
# Generate privately (openssl rand -hex 32); remove after setup.
INSTALLER_SECRET=
# First-install setup screen. Set to true only during initial setup, then false. Accepts true/false.
INSTALLATION_SETUP_ENABLED=false
# Staff sessions lock after this many idle minutes and require password re-verification.
STAFF_IDLE_MINUTES=30
# Comma-separated allowlist of printer bridge hosts (HTTPS only).
PRINTER_BRIDGE_HOSTS=bridge.local

# Optional isolated development demo only; never use live credentials here.
DEMO_RESET_ENABLED=false
DEMO_RESET_TOKEN=
DEMO_DB_HOST=
DEMO_DB_PORT=3306
DEMO_DB_DATABASE=
DEMO_DB_USERNAME=
DEMO_DB_PASSWORD=
DEMO_DB_SSL_CA=

# Proposed local request limits; tune only with measured installation evidence.
REQUEST_LIMIT_MAX=120
REQUEST_LIMIT_SECONDS=60
LOGIN_LIMIT_MAX=10
LOGIN_LIMIT_SECONDS=60
