# Local example only. Each deployment supplies its own HTTPS origin and key.
APP_NAME="Hotel System"
APP_ENV=local
APP_URL=http://127.0.0.1:8000
APP_KEY=
# Detailed public errors are disabled in application configuration.
# Private database credentials belong to this installation only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Provider CA file for a remote TLS connection, when required by the host.
DB_SSL_CA=
