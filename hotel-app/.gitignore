/.env
/.env.*
!/.env.example
/vendor/

# Local Composer credentials and development dependencies/output.
/auth.json
/node_modules/
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
/test-results/
/playwright-report/

# Every installation owns its runtime files and uploaded media.
/storage/**
!/storage/**/
!/storage/**/.gitignore
# Runtime media is per-installation; only the hardening file is tracked.
/public/media/*
!/public/media/.htaccess
__pycache__/
